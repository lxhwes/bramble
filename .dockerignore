# Dependencies and build outputs — rebuilt inside Docker
node_modules
.svelte-kit
build

# Version control
.git
.gitignore

# Local Cloudflare / Wrangler state
.wrangler

# Local data directory (SQLite file; provided via volume at runtime)
data

# Local env files (runtime config is passed via docker-compose environment)
.env
.env.*

# OS artifacts
.DS_Store
Thumbs.db

# Per-developer agent/editor config
.claude

# Playwright CLI artifacts
.playwright-cli

# Test and CI artifacts
coverage
*.log

# Docs and CI config — the build never reads them, and excluding them keeps
# documentation-only changes on a full layer-cache hit.
# `*.md` matches root level only, which is why `docs` is listed separately.
docs
.github
*.md
