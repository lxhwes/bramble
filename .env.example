# Bramble environment variables.
# Copy to .env for local self-host runs. The Cloudflare target reads bindings
# from wrangler.toml and the Pages dashboard, not from this file.

# Build/runtime target: "node" (self-host) or "cloudflare" (default).
BRAMBLE_TARGET=node

# Port the Node server listens on (adapter-node). Default 3000.
PORT=3000

# Path to the SQLite database file (node target). Created on first run.
BRAMBLE_DB_PATH=./data/bramble.sqlite

# Public origin of the deployment. REQUIRED on the node target — adapter-node
# rejects cross-origin form POSTs (session create, vote) without it.
ORIGIN=http://localhost:3000

# Days of inactivity before a session is pruned. Default 90.
BRAMBLE_RETENTION_DAYS=90

# Behind a reverse proxy, set these so the in-process rate limiter sees the
# real client IP instead of the proxy's. See adapter-node docs.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Cloudflare Web Analytics beacon token (Cloudflare target only). Leave unset
# on self-host — no beacon is rendered when empty.
# PUBLIC_CF_ANALYTICS_TOKEN=
